# Raw downloaded data — large, regenerable from A1's download script.
/data/raw/

# Bulk CSV is never committed...
*.csv

# ...but the hand-curated evidence file is source, not data. Keep it tracked.
!/data/evidence.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Notebooks / editors
.ipynb_checkpoints/
.idea/
.vscode/

# OS
Thumbs.db
.DS_Store

# ...and small DERIVED csv under data/processed IS source of truth for the
# model (metro crosswalk, poverty thresholds). The bulk PUMS csv lives in
# /data/raw, which is already excluded wholesale above.
!/data/processed/*.csv

.env

# pytest
.pytest_cache/

# Browser-driver output. The scroll captures are working artefacts, not
# deliverables; the three named screenshots below are kept as evidence.
docs/screenshots/sec_*.png
docs/screenshots/body_*.txt

# Vendored upstream atlas (kp224/simcity), built. 109MB of bundled DC map
# assets; cloned and built by dc_api/setup_frontend.sh rather than committed.
/frontend/

# The Council's codified DC Code, cloned by dc_api/setup_dc_code.sh.
# Large, and upstream. The committed artefact is the index it produces,
# data/dc_code/, not the corpus.
/dc_code/
